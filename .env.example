# JoyDigi HR — environment template. Copy to `.env` and fill in real values
# ON THE SERVER ONLY. Never commit `.env` or real values; this file must only
# ever hold placeholders.

# --- Core (production must use DEBUG=False; see joydigi/settings/security.py)
DEBUG=False
JOYDIGI_ENV=production
SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
ALLOWED_HOSTS=checkin.joydigi.net,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://checkin.joydigi.net

# --- Database (prefer a dedicated app user, not the `postgres` superuser)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/joydigi_hr

# --- Setup wizard and demo-data loader (no default; unset = disabled)
DB_INIT_PASSWORD=<random value, e.g. python -c "import secrets; print(secrets.token_hex(24))">
# Password for demo employees created by the demo loader; leave empty so they cannot log in.
DEMO_EMPLOYEE_PASSWORD=

# --- Services (paths and secrets are provisioned by the deploy workflow)
FIREBASE_CREDENTIALS_FILE=/var/www/joydigi-hr/secrets/firebase-service-account.json
OFFICE_IP_UPDATER_SECRET=<random value>
ENABLE_DB_BACKUP=True
ATTENDANCE_SCHEDULER_MODE=embedded
