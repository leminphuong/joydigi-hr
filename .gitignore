# Phase AUTH-6G.3 — temporary runtime diagnostic written by
# joydigi_api/api_views/refresh_diagnostics.py. Never commit it.
auth_refresh_diagnostic.jsonl

# Firebase Admin service account, written onto the server at deploy time
# from the FIREBASE_SERVICE_ACCOUNT_JSON GitHub Actions secret. It is a
# private key: it must never be committed. Only this file is ignored, so
# anything else placed in secrets/ stays visible to review.
secrets/firebase-service-account.json

# Secrets and key material (security clean-up 2026-11-08). Real values live
# only in the server's .env / secret store, never in this repository.
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ovpn
*service-account*.json
*-credentials.json
credentials*.json
