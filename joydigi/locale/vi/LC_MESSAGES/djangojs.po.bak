msgid "An unexpected error occurred. Please refresh the page."
msgstr "Đã xảy ra lỗi không mong muốn. Vui lòng làm mới trang."

msgid "Do you really want to validate all the selected attendances?"
msgstr ""
"Bạn có thực sự muốn xác nhận tất cả những người tham dự đã chọn không?"

msgid "No rows are selected from Validate Attendances."
msgstr "Không có hàng nào được chọn từ Xác thực chấm công."

msgid "Do you really want to approve OT for all the selected attendances?"
msgstr ""
"Bạn có thực sự muốn phê duyệt OT cho tất cả những người tham dự đã chọn "
"không?"

msgid "No rows are selected from OT Attendances."
msgstr "Không có hàng nào được chọn từ Chấm công OT."

msgid "Do you really want to reject all the selected attendance requests?"
msgstr "Bạn có thực sự muốn từ chối tất cả các yêu cầu tham dự đã chọn không?"

msgid "Pending Attendance Update Request!"
msgstr "Yêu cầu cập nhật điểm danh đang chờ xử lý!"

msgid ""
"An attendance request exists for updating this attendance prior to "
"validation."
msgstr ""
"Có một yêu cầu chấm công để cập nhật việc chấm công này trước khi xác nhận."

msgid "View Request"
msgstr "Xem yêu cầu"

msgid "Some selected requests have already been approved."
msgstr "Một số yêu cầu được chọn đã được phê duyệt."

msgid "Some selected requests have already been rejected."
msgstr "Một số yêu cầu được chọn đã bị từ chối."

msgid "Do you wish to create a Leave Report?"
msgstr "Bạn có muốn tạo Báo cáo Nghỉ phép không?"

msgid "Do you want to reject the selected leave requests?"
msgstr "Bạn có muốn từ chối các yêu cầu nghỉ phép đã chọn không?"

msgid "Do you want to send the payslip by mail?"
msgstr "Bạn có muốn gửi phiếu lương qua đường bưu điện không?"

msgid "Name of Employees"
msgstr "Tên nhân viên"

msgid "Amount"
msgstr "Số tiền"

msgid "Upload Completed!"
msgstr "Tải lên đã hoàn tất!"

msgid "Imported Successfully!"
msgstr "Đã nhập thành công!"

msgid "Please upload a file with the .xlsx extension only."
msgstr "Vui lòng tải lên tệp chỉ có phần mở rộng .xlsx."

msgid "visible"
msgstr "có thể nhìn thấy"

msgid "bgcolor"
msgstr "màu sắc"

msgid "bordercolor"
msgstr "màu viền"

msgid "borderwidth"
msgstr "chiều rộng biên giới"

msgid "thickness"
msgstr "độ dày"

msgid "autorange"
msgstr "tự động sắp xếp"

msgid "range"
msgstr "phạm vi"

