msgstr "x"

msgid "y"
msgstr "y"

msgid "minor"
msgstr "thứ yếu"

msgid "label"
msgstr "nhãn"

msgid "arrowlen"
msgstr "mũi tên"

msgid "source"
msgstr "nguồn"

msgid "target"
msgstr "mục tiêu"

msgid "value"
msgstr "giá trị"

msgid "line.color"
msgstr "dòng.color"

msgid "line.width"
msgstr "dòng.width"

msgid "hoverinfo"
msgstr "thông tin di chuột"

msgid "hovertemplate"
msgstr "mẫu di chuột"

msgid "color"
msgstr "màu sắc"

msgid "hovercolor"
msgstr "màu di chuột"

msgid "customdata"
msgstr "dữ liệu tùy chỉnh"

msgid "punc"
msgstr "cú đấm"

msgid "name"
msgstr "tên"

msgid "keyword"
msgstr "từ khóa"

msgid "arrow"
msgstr "mũi tên"

msgid "operator"
msgstr "toán tử"

msgid "close"
msgstr "đóng"

msgid "Confirm"
msgstr "Xác nhận"

msgid "Close"
msgstr "Đóng"

msgid "Cancel"
msgstr "Hủy bỏ"

msgid "Selected"
msgstr "Đã chọn"

msgid "Uploading..."
msgstr "Đang tải lên..."

msgid "No Records found"
msgstr "Không tìm thấy bản ghi nào"

msgid "Do you want to download the excel file?"
msgstr "Bạn có muốn tải xuống tệp excel không?"

msgid "Do you want to download the template?"
msgstr "Bạn có muốn tải mẫu xuống không?"

msgid "No rows are selected from the records."
msgstr "Không có hàng nào được chọn từ các bản ghi."

msgid "Do you really want to delete all the selected records?"
msgstr "Bạn có thực sự muốn xóa tất cả các bản ghi đã chọn?"

msgid "Do you really want to archive all the selected records?"
msgstr "Bạn có thực sự muốn lưu trữ tất cả các bản ghi đã chọn không?"

msgid "Do you really want to approve all the selected requests?"
msgstr "Bạn có thực sự muốn phê duyệt tất cả các yêu cầu đã chọn không?"

msgid "Do you really want to unarchive all the selected records?"
msgstr "Bạn có thực sự muốn hủy lưu trữ tất cả các bản ghi đã chọn không?"

msgid "Ok"
msgstr "Được rồi"

#, python-format
msgid "Total vacancy is %(vacancy)s."
msgstr "Tổng số chỗ trống là %(vacancy)s."

#, python-format
msgid ""
"Are you sure to change the candidate from %(from)s stage to %(to)s stage"
msgstr ""
"Bạn có chắc chắn thay đổi ứng viên từ giai đoạn %(from)s sang giai đoạn "
"%(to)s không"

msgid "Stage updated"
msgstr "Đã cập nhật giai đoạn"

msgid "Confirm Stage Change"
msgstr "Xác nhận thay đổi giai đoạn"

#, python-format
msgid ""
"The candidate is being moved from %(from)s to the %(to)s stage. Do you want "
"to proceed?"
msgstr ""
"Ứng viên đang được chuyển từ giai đoạn %(from)s sang giai đoạn %(to)s. Bạn "
"có muốn tiếp tục không?"

msgid "Don't show this again in this session"
msgstr "Không hiển thị lại điều này trong phiên này"

msgid "Cannot Change Stage"
msgstr "Không thể thay đổi giai đoạn"

msgid "This move is not allowed."
msgstr "Động thái này không được phép."
